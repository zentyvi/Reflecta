// use prisma-8
model User {
  id              ObjectId @id @map("_id")
  googleId        String?
  githubId        String?
  userType        UserType
  username        String   @unique
  displayName     String?
  password        String?
  createdAt       Date     @onCreate(now())
  updatedAt       Date     @onCreate(now()) @onUpdate(now())
  memories        Memory[]
  passwordVersion Int32?

  @@map("users")
}

enum UserType {
  GOOGLE
  USERNAME
  GITHUB
}

model Memory {
  id        ObjectId @id @map("_id")
  date      Date
  title     String
  rating    Int32
  note      String?
  createdAt Date     @onCreate(now())
  updatedAt Date     @onCreate(now()) @onUpdate(now())
  author    User     @relation(references: [id], fields: [authorId])
  authorId  ObjectId
  events    Event[]

  @@map("memories")
}

model Event {
  id       ObjectId @id @map("_id")
  title    String
  rating   Int32?
  memory   Memory   @relation(references: [id], fields: [memoryId])
  memoryId ObjectId

  @@map("events")
}
