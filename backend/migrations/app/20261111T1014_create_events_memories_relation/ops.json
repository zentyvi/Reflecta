[
  {
    "id": "field.memories.events.unset",
    "label": "Remove field events from collection memories",
    "operationClass": "destructive",
    "name": "field.memories.events.unset",
    "precheck": [],
    "run": [
      {
        "collection": "memories",
        "command": {
          "kind": "rawUpdateMany",
          "collection": "memories",
          "filter": {
            "events": {
              "$exists": true
            }
          },
          "update": {
            "$unset": {
              "events": ""
            }
          },
          "bypassDocumentValidation": true
        },
        "meta": {
          "target": "mongo",
          "storageHash": "",
          "lane": "mongo-raw"
        }
      }
    ],
    "postcheck": [
      {
        "description": "no document in memories holds events",
        "source": {
          "collection": "memories",
          "command": {
            "kind": "rawAggregate",
            "collection": "memories",
            "pipeline": [
              {
                "$match": {
                  "events": {
                    "$exists": true
                  }
                }
              },
              {
                "$limit": 1
              }
            ]
          },
          "meta": {
            "target": "mongo",
            "storageHash": "",
            "lane": "mongo-raw"
          }
        },
        "filter": {
          "kind": "exists",
          "field": "_id",
          "exists": true
        },
        "expect": "notExists"
      }
    ]
  },
  {
    "id": "validator.events.update",
    "label": "Update validator on events (added: memoryId)",
    "operationClass": "widening",
    "precheck": [
      {
        "description": "collection events exists",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "field",
          "field": "name",
          "op": "$eq",
          "value": "events"
        },
        "expect": "exists",
        "object": "collection \"events\""
      }
    ],
    "execute": [
      {
        "description": "modify events",
        "command": {
          "kind": "collMod",
          "collection": "events",
          "validator": {
            "$jsonSchema": {
              "additionalProperties": false,
              "bsonType": "object",
              "properties": {
                "_id": {
                  "bsonType": "objectId"
                },
                "memoryId": {
                  "bsonType": "objectId"
                },
                "rating": {
                  "bsonType": [
                    "null",
                    "int"
                  ]
                },
                "title": {
                  "bsonType": "string"
                }
              },
              "required": [
                "_id",
                "memoryId",
                "title"
              ]
            }
          },
          "validationLevel": "strict",
          "validationAction": "error"
        }
      }
    ],
    "postcheck": [
      {
        "description": "validator applied on events",
        "source": {
          "kind": "listCollections"
        },
        "filter": {
          "kind": "and",
          "exprs": [
            {
              "kind": "field",
              "field": "name",
              "op": "$eq",
              "value": "events"
            },
            {
              "kind": "field",
              "field": "options.validationLevel",
              "op": "$eq",
              "value": "strict"
            },
            {
              "kind": "field",
              "field": "options.validationAction",
              "op": "$eq",
              "value": "error"
            },
            {
              "kind": "field",
              "field": "options.validator.$jsonSchema",
              "op": "$eq",
              "value": {
                "additionalProperties": false,
                "bsonType": "object",
                "properties": {
                  "_id": {
                    "bsonType": "objectId"
                  },
                  "memoryId": {
                    "bsonType": "objectId"
                  },
                  "rating": {
                    "bsonType": [
                      "null",
                      "int"
                    ]
                  },
                  "title": {
                    "bsonType": "string"
                  }
                },
                "required": [
                  "_id",
                  "memoryId",
                  "title"
                ]
              }
            }
          ]
        },
        "expect": "exists"
      }
    ]
  },
