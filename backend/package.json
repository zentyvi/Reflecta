    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@prisma/composer": "0.35.0",
    "@prisma/composer-prisma-cloud": "0.35.0",
    "@prisma/orm-mongo": "8.0.0-rc.20",
    "alchemy": "2.0.0-beta.83",
    "arktype": "^2.2.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
