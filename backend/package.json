{
  "name": "backend",
  "private": true,
  "packageManager": "npm@10.9.3",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest --watch",
